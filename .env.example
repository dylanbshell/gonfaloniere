# Copy to .env and fill in. Never commit .env.
# OpenRouter (all probe models and the Claude judges): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
# Tinker (Capitulation Pilot training and Tinker-hosted evaluation only): https://tinker-console.thinkingmachines.ai
TINKER_API_KEY=your-tinker-key
# The live store (TD v0.22; mini-game --retrieval embeddings or --lore on only): PostgreSQL with pgvector.
DATABASE_URL=postgres://user@localhost:5432/gonfaloniere
# The embedding model: any OpenAI-compatible embeddings endpoint. Only the model ID is ever recorded.
EMBEDDING_MODEL_BASE_URL=https://your-embeddings-endpoint/v1
EMBEDDING_MODEL_API_KEY=your-embeddings-key
EMBEDDING_MODEL_ID=your-embedding-model
# Tests: a local PostgreSQL with pgvector for test/store.test.ts (skipped when unset).
TEST_DATABASE_URL=postgres://user@localhost:5432/gonfaloniere_test
