{
  "name": "gonfaloniere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "tsx src/harness/run.ts",
    "score": "tsx src/harness/score.ts",
    "typecheck": "tsc --noEmit",
    "judge": "tsx src/harness/judge-run.ts",
    "pilot:data": "tsx src/pilot/datagen.ts",
    "pilot:pairs": "tsx src/pilot/pairs.ts",
    "judge:compare": "tsx src/harness/judge-compare.ts",
    "pilot:refilter": "tsx src/pilot/refilter.ts",
    "pilot:chosen": "tsx src/pilot/chosen.ts",
    "strategy": "tsx src/strategy/run.ts",
    "strategy:judge": "tsx src/strategy/judge.ts",
    "publish:results": "tsx src/harness/publish.ts && npm run -s score > results/published/score-report-probe.md && PROBE_RESULTS_DIR=results/pilot npm run -s score > results/published/score-report-pilot.md && npm run -s strategy:judge -- --a deepseek-v4.1-flash --b qwen3.8-27b --ref gpt-5.4 --report > results/published/strategy-probes.md",
    "minigame": "tsx src/minigame/run.ts",
    "minigame:measures": "tsx src/minigame/measures.ts",
    "minigame:replay": "tsx src/minigame/replay.ts",
    "minigame:view": "tsx src/minigame/view.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "openai": "^7.39.0",
    "pg": "8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
